# Public Supabase project values. The anon key is intentionally safe to expose only
# when the included RLS policies and RPC grants are installed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Supabase automatically injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# into hosted Edge Functions. Do not copy the service-role key into this file.
# Custom server-only secrets: configure in Supabase Edge Functions > Secrets.
# Email alerts (recommended). With Resend's onboarding sender, the destination
# must be the email address used for the Resend account until a domain is verified.
RESEND_API_KEY=re_YOUR_SERVER_SIDE_API_KEY
PORTFOLIO_NOTIFICATION_EMAIL=you@example.com
PORTFOLIO_NOTIFICATION_FROM=Portfolio Alerts <onboarding@resend.dev>
# Optional Slack-compatible fallback when email is not configured.
PORTFOLIO_NOTIFICATION_WEBHOOK_URL=https://YOUR_NOTIFICATION_PROVIDER_WEBHOOK
PORTFOLIO_ALLOWED_ORIGIN=https://imlokesh.me
# Keep false in production. Enable true only on the backend used for localhost testing.
PORTFOLIO_ALLOW_LOCALHOST=false
